<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Mini Message Board</title>
</head>
<body>
    <main>
        <div class="userCard">
            <img src="<%= currentUser ? currentUser.pic : '/guest.svg' %>" alt="<%= currentUser ? currentUser.name : 'guest-pic' %>">
            <p><%= currentUser ? currentUser.name : 'guest' %></p>
            <div>
               <% if (!currentUser) {%>
                 <button type="button" class="openModal">Log In</button>
               <% } else { %>
                 <button type="button" class="logout">Log Out</button>
               <% } %>
            </div>
        </div>
        <div class="messageBoard">
            <% messages.forEach(function(message) { %>
              <% const user = users.find(function(user) { return user.id === message.userId; }); %>
              <div class="message <%= currentUser && user ? currentUser.id === user.id ? 'activeUser' : '' : '' %>">
                <img src="<%= user ? user.pic : '/guest.svg' %>" alt="<%= user ? user.name : 'guest' %>">
                <p><%= message.text %></p>
                <p><%= message.added %></p>
              </div> 
            <% }); %>
        </div>
        <form class="newMsgForm" action="/newMsg" method="POST">
            <input type="text" placeholder="Write a message" name="text" required>
            <button type="submit">Send</button>
        </form>
    </main>
      <% if (open) { %>
        <dialog open>
      <% } else { %>
        <dialog>
      <% } %>
            <div class="modal-card">
              <button type="button" class="closeModal" aria-label="Close login form">×</button>
              <div class="modal-heading">
                <span class="modal-kicker">Welcome back</span>
                <h2>Join the conversation</h2>
                <p>Sign in to post messages and see your activity.</p>
              </div>
              <form action="/newUser" method="POST">
                <% if (authError) { %>
                  <p class="authError"><%= authError %></p>
                <% } %>
                <label>
                  <span>Name</span>
                  <input type="text" placeholder="Your name" name="name" autocomplete="username" required>
                </label>
                <label>
                  <span>Password</span>
                  <input type="password" placeholder="Your password" name="password" autocomplete="current-password" required>
                </label>
                <button type="submit">Enter</button>
              </form>
            </div>
        </dialog>
    <script>
        const modal = document.querySelector('dialog');
        const openModalBtn = document.querySelector('.userCard button.openModal');
        const closeModalBtn = document.querySelector('.closeModal');
        const logoutBtn = document.querySelector('.userCard button.logout');

        const messageBoard = document.querySelector('.messageBoard');

        document.addEventListener('DOMContentLoaded', () => {
            messageBoard.scrollTop = messageBoard.scrollHeight;
        });

        if (openModalBtn) {
            openModalBtn.addEventListener('click', () => {
                modal.showModal();
            });
        }

        closeModalBtn.addEventListener('click', () => {
            modal.close();
        });

        if (logoutBtn) {
            logoutBtn.addEventListener('click', async () => {
                const response = await fetch('/logout', {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
            });
            const data = await response.json();
            if (data && data.ok) {
                location.reload();
            }
        });
        }

        modal.addEventListener('click', (e) => {
            if (e.target !== modal) return;
            modal.close(); 
        });
    </script>
</body>
</html>